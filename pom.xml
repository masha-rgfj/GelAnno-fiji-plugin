<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.scijava</groupId>
    <artifactId>pom-scijava</artifactId>
    <version>37.0.0</version>
    <relativePath />
  </parent>

  <groupId>gelato</groupId>
  <artifactId>gelato</artifactId>
  <version>1.0.1</version>
  <packaging>jar</packaging>

  <name>Gelato</name>
  <description>ImageJ1 and Fiji/ImageJ2 plugin for traceable western blot figures</description>
  
    <!-- Project information -->
  <url>https://github.com/masha-rgfj/Gelato-fiji-plugin</url>
  <inceptionYear>2026</inceptionYear>

  <organization>
    <name>Lab for Cellular RNA Biology</name>
    <url>https://lcrbiology.wixsite.com/lcrb</url>
  </organization>

  <licenses>
    <license>
      <name>GNU AGPL v3</name>
      <url>https://www.gnu.org/licenses/agpl-3.0.en.html</url>
      <distribution>repo</distribution>
    </license>
  </licenses>

  <developers>
    <developer>
      <id>masha-rgfj</id>
      <name>Maria A. Pirozhkova</name>
      <email>pirozhkova@mail.tau.ac.il</email>

      <url>https://github.com/masha-rgfj</url>

      <organization>Lab for Cellular RNA Biology</organization>
      <organizationUrl>https://lcrbiology.wixsite.com/lcrb</organizationUrl>

      <roles>
        <role>founder</role>
        <role>lead</role>
        <role>developer</role>
        <role>maintainer</role>
      </roles>
    </developer>
  </developers>

  <contributors>
    <contributor>
      <name>Elisheva Babitz</name>
    </contributor>
  </contributors>

  <mailingLists />

  <!-- Source-code repository information. -->
  <scm>
    <connection>
      scm:git:https://github.com/masha-rgfj/Gelato-fiji-plugin.git
    </connection>
    <developerConnection>
      scm:git:https://github.com/masha-rgfj/Gelato-fiji-plugin.git
    </developerConnection>
    <tag>HEAD</tag>
    <url>https://github.com/masha-rgfj/Gelato-fiji-plugin</url>
  </scm>

  <issueManagement>
    <system>GitHub Issues</system>
    <url>https://github.com/masha-rgfj/Gelato-fiji-plugin/issues</url>
  </issueManagement>

  <ciManagement>
    <system>None</system>
  </ciManagement>

  <properties>
    <maven.compiler.release>8</maven.compiler.release>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
  </properties>

  <dependencies>
    <!-- Supplied by both ImageJ1 and Fiji at runtime. -->
    <dependency>
      <groupId>net.imagej</groupId>
      <artifactId>ij</artifactId>
      <scope>provided</scope>
    </dependency>

    <!-- Required by the ImageJ2/SciJava @Plugin entry point. -->
    <dependency>
      <groupId>org.scijava</groupId>
      <artifactId>scijava-common</artifactId>
    </dependency>

    <!-- Required by Gelato PDF export. -->
    <dependency>
      <groupId>com.itextpdf</groupId>
      <artifactId>itextpdf</artifactId>
      <version>5.5.13.3</version>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!--
        Explicit processor configuration is needed on JDK 23 and newer.
        It creates META-INF/json/org.scijava.plugin.Plugin for Fiji/ImageJ2.
      -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.14.1</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.scijava</groupId>
              <artifactId>scijava-common</artifactId>
              <version>${scijava-common.version}</version>
            </path>
          </annotationProcessorPaths>
          <annotationProcessors>
            <annotationProcessor>org.scijava.annotations.AnnotationProcessor</annotationProcessor>
          </annotationProcessors>
        </configuration>
      </plugin>
    </plugins>
  </build>
 
  <repositories>
    <repository>
      <id>scijava.public</id>
      <url>https://maven.scijava.org/content/groups/public</url>
    </repository>
  </repositories>
</project>
